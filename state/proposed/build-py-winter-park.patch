 def _clinic_category(clinic):
     return clinic.get("category") or DEFAULT_CATEGORY
 
+# Provider-eligibility widening (EXPANSION_PLAN "widen the supply, keep the bar").
+# Non-surgical treatments (Botox, fillers, laser, microneedling, HydraFacial, chemical
+# peel, Morpheus8, IV therapy, CoolSculpting) may be listed by ANY verified medical/
+# aesthetic practice that performs them on its own published menu — not only businesses
+# categorized "med-spa". Dermatology and plastic-surgery practices are high-authority
+# injectors and materially increase verified supply, so they are admitted as SOURCES for
+# the non-surgical (med-spa) category pages. The bar does not move: a provider still only
+# appears for a treatment it actually lists (t in clinic["treatments"], menu-verified),
+# ratings still come from the permitted API, nothing is fabricated.
+#
+# The SURGICAL vertical stays distinct: the plastic-surgery category is sourced ONLY from
+# clinics whose own category is plastic-surgery, so this widening never pulls a med-spa or
+# dermatology listing onto a surgical (BBL/tummy-tuck/etc.) page, and never pulls a
+# surgical procedure onto a non-surgical page (the treatment-slug sets are disjoint).
+NONSURGICAL_CATEGORIES = {"med-spa"}
+NONSURGICAL_SOURCE_CATEGORIES = {
+    "med-spa", "medical-spa", "medspa", "dermatology", "plastic-surgery",
+    "aesthetic", "aesthetics", "cosmetic-dermatology", "day-spa", "spa", "wellness",
+}
+
+def _eligible_for_category(clinic, category):
+    """Is this clinic an eligible SOURCE of listings for `category`'s pages?
+
+    - Same-category clinics always qualify (existing behavior).
+    - Non-surgical category pages additionally admit derm/plastic-surgery/aesthetic
+      practices as sources. Downstream matching still requires the clinic to list the
+      specific treatment, so this only ever adds real, menu-verified supply.
+    - Surgical categories remain sourced strictly from their own category.
+    """
+    cc = _clinic_category(clinic)
+    if cc == category:
+        return True
+    if category in NONSURGICAL_CATEGORIES and cc in NONSURGICAL_SOURCE_CATEGORIES:
+        return True
+    return False
+
