<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Octoru — med spa treatment directory</title>
<meta name="description" content="Find and compare health & wellness providers by treatment and city — Botox, lip filler, CoolSculpting, laser hair removal, and microneedling. Verified providers, prices, and ratings.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/styles.css">
<!-- Google Analytics 4 (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-382MGP656E"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-382MGP656E');
</script>
</head>
<body>

<header class="topbar">
  <div class="wrap">
    <a href="/" style="text-decoration:none">
      <span class="brand-lockup"><svg class="brand-mark" width="28" height="28" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg"><polygon points="62,47 47,62 25,62 10,47 10,25 25,10 47,10 62,25" fill="#1447E6"/><path d="M27,33 H33 V27 H39 V33 H45 V39 H39 V45 H33 V39 H27 Z" fill="#fff"/></svg><span class="wordmark" style="font-size:21px">octoru</span></span>
      <div class="label">Health &amp; wellness directory</div>
    </a>
    <span class="label blue">South Florida</span>
  </div>
</header>

<main class="wrap">
  <section class="hero home-hero">
    <span class="label blue">South Florida</span>
    <h1>Find &amp; compare med spas<br>by treatment and city</h1>
    <p class="lead">Verified providers for Botox, lip filler, CoolSculpting, laser hair removal, and
      microneedling — by city, with addresses, prices, and ratings, so you can compare before you book.</p>
    {%- if stats %}
    <div class="statbar">
      <span><b>{{ stats.listings }}</b> provider listings</span>
      <span><b>{{ stats.cities }}</b> cities</span>
      <span><b>{{ stats.counties }}</b> counties</span>
      <span class="ok">✓ verified contact details</span>
    </div>
    {%- endif %}
  </section>

  <div class="dir-search">
    <input id="dir-q" type="search" placeholder="Search a city or county — e.g. “coral gables” or “broward”"
           aria-label="Filter the directory">
  </div>

  {%- for g in groups %}
  <section class="nbhd-group" id="{{ g.slug }}" data-search="{{ g.name | lower }}">
    <div class="nbhd-head"><h2>{{ g.name }}</h2><span class="label">{{ g.cities | length }} cit{{ "y" if g.cities|length == 1 else "ies" }}</span></div>
    <div class="card-grid">
      {%- for c in g.cities %}
      <a class="dcard" href="{{ c.url }}" data-search="{{ (c.name ~ ' ' ~ g.name) | lower }}">
        <div class="dcard-top">
          <span class="dcard-title">{{ c.name }}</span>
          <span class="dcard-arrow" aria-hidden="true">→</span>
        </div>
        <div class="dcard-foot">
          <span class="label">{{ c.n_pages }} treatment{{ "s" if c.n_pages != 1 }}</span>
        </div>
      </a>
      {%- endfor %}
    </div>
  </section>
  {%- endfor %}

  <p id="dir-empty" class="meta" style="display:none;padding:24px 0;">No cities match — try a county like “Broward” or a city like “Boca Raton”.</p>

  <script>
    (function () {
      var q = document.getElementById('dir-q');
      var groups = Array.prototype.slice.call(document.querySelectorAll('.nbhd-group'));
      var empty = document.getElementById('dir-empty');
      if (!q) return;
      q.addEventListener('input', function () {
        var term = q.value.trim().toLowerCase(); var any = false;
        groups.forEach(function (g) {
          var cards = Array.prototype.slice.call(g.querySelectorAll('.dcard')); var hitGroup = false;
          cards.forEach(function (c) {
            var hit = !term || c.getAttribute('data-search').indexOf(term) !== -1 || g.getAttribute('data-search').indexOf(term) !== -1;
            c.style.display = hit ? '' : 'none'; if (hit) hitGroup = true;
          });
          g.classList.toggle('is-hidden', !hitGroup); if (hitGroup) any = true;
        });
        empty.style.display = any ? 'none' : 'block';
      });
    })();
  </script>
</main>

<footer class="foot">
  <div class="wrap">
    Octoru is an independent directory. Listings reflect publicly available information; ratings are sourced via permitted APIs.
    <a href="/claim.html">Claim a listing</a> · <a href="/privacy">Privacy</a> · <a href="/about">About</a>
    <div class="label" style="margin-top:10px;">Updated {{ last_updated }}</div>
  </div>
</footer>

</body>
</html>
