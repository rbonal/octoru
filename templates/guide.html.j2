<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>How much does {{ treatment.name }} cost in {{ neighborhood.name }}, FL? ({{ year }} price guide)</title>
<meta name="description" content="Real {{ treatment.name | lower }} prices from {{ n_clinics }} verified providers in {{ neighborhood.name }}, Florida. Compare costs, what affects pricing, and how to choose a provider.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/styles.css">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/x-icon" sizes="any" href="/assets/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
<meta property="og:image" content="https://octoru.com/assets/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://octoru.com/assets/og-image.png">
{%- if near_duplicate %}
<!-- Near-duplicate guard: derived from a listing page with too little local substance to
     stand alone in the index. Reachable and link-passing, but not indexed. -->
<meta name="robots" content="noindex, follow">
{%- endif %}
<link rel="canonical" href="{{ site_url }}{{ guide_url }}">

{%- if faqs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for f in faqs %}
    {
      "@type": "Question",
      "name": {{ f.q | tojson }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | tojson }} }
    }{{ "," if not loop.last }}
    {%- endfor %}
  ]
}
</script>
{%- endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type":"ListItem","position":1,"name":"Home","item":"{{ site_url }}/"},
    {"@type":"ListItem","position":2,"name":"{{ geo.state_name }}","item":"{{ site_url }}/{{ geo.state }}/"},
    {"@type":"ListItem","position":3,"name":"{{ geo.county_name }}","item":"{{ site_url }}/{{ geo.state }}/{{ geo.county }}/"},
    {"@type":"ListItem","position":4,"name":"{{ neighborhood.name }}","item":"{{ site_url }}/{{ geo.state }}/{{ geo.county }}/{{ geo.city }}/"},
    {"@type":"ListItem","position":5,"name":"{{ treatment.name }} providers","item":"{{ site_url }}{{ listing_url }}"},
    {"@type":"ListItem","position":6,"name":"{{ treatment.name }} cost guide","item":"{{ site_url }}{{ guide_url }}"}
  ]
}
</script>
<!-- Google Analytics 4 (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-382MGP656E"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-382MGP656E');
</script>
</head>
<body>

<header class="topbar">
  <div class="wrap">
    <a href="/" style="text-decoration:none">
      <span class="brand-lockup"><svg class="brand-mark" width="28" height="28" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg"><polygon points="62,47 47,62 25,62 10,47 10,25 25,10 47,10 62,25" fill="#1447E6"/><path d="M27,33 H33 V27 H39 V33 H45 V39 H39 V45 H33 V39 H27 Z" fill="#fff"/></svg><span class="wordmark" style="font-size:21px">octoru</span></span>
      <div class="label">Med spa &amp; aesthetics directory</div>
    </a>
    <a href="/advertise.html" class="nav-adv-btn">Advertise with us</a>
  </div>
</header>

<main class="wrap">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a><span class="sep">/</span>
    <a href="/{{ geo.state }}/">{{ geo.state_name }}</a><span class="sep">/</span>
    <a href="/{{ geo.state }}/{{ geo.county }}/">{{ geo.county_name }}</a><span class="sep">/</span>
    <a href="/{{ geo.state }}/{{ geo.county }}/{{ geo.city }}/">{{ neighborhood.name }}</a><span class="sep">/</span>
    <a href="{{ listing_url }}">{{ treatment.name }}</a><span class="sep">/</span>
    <span aria-current="page">Cost guide</span>
  </nav>

  <article class="guide-article">
    <header class="guide-hero">
      <div class="label blue" style="margin-bottom:10px">{{ year }} price guide</div>
      <h1>How much does {{ treatment.name }} cost in {{ neighborhood.name }}, FL?</h1>
      {#- Lead with the referential market figure — it's the answer the query asks for and
          it exists for every treatment we can source. The observed local figure, when we
          have one, sits underneath it and is labeled as what providers here publish. -#}
      {%- if reference and reference.available %}
      <div class="guide-price-callout">
        <span class="guide-price-n">{% if reference.metro %}{{ reference.metro.display }}{% else %}{{ reference.national.display }}{% endif %}</span>
        <span class="guide-price-note">
          {#- metro.basis already names the geography ("per treatment, Miami metro average"),
              so don't prefix it with "Miami-metro average" as well. -#}
          {%- if reference.metro %}{{ reference.metro.basis }} — {{ reference.metro.source_name }}{% if reference.metro.year %}, {{ reference.metro.year }}{% endif %}
          {%- else %}{{ reference.national.basis }}, U.S. average — {{ reference.national.source_name }}{% if reference.national.year %}, {{ reference.national.year }}{% endif %}{% endif %}
          · referential, not a quote
        </span>
      </div>
      {%- endif %}
      {%- if price_display %}
      <div class="guide-price-callout guide-price-observed">
        <span class="guide-price-n">{{ price_display }}</span>
        <span class="guide-price-note">published by verified {{ neighborhood.name }} providers — see full list below</span>
      </div>
      {%- endif %}
      {%- if neighborhood_context %}
      <p class="guide-lead">{{ neighborhood_context }}</p>
      {%- endif %}
    </header>

    {%- if cost and cost.has_prices %}
    <section class="guide-section">
      <h2>{{ treatment.name }} prices in {{ neighborhood.name }}</h2>
      <p>
        Based on the {{ n_clinics }} verified providers in the Octoru directory,
        {{ treatment.name | lower }} in {{ neighborhood.name }} starts at
        <strong>${{ cost.low }} {{ unit }}</strong>
        {%- if cost.high and cost.high != cost.low %} and goes up to <strong>${{ cost.high }} {{ unit }}</strong>{% endif %}.
        {{ cost.coverage_label | capitalize }}.
      </p>
      <p style="margin-top:12px">These are published starting prices — your final cost will depend on the treatment area, the number of units or sessions required, and the provider you choose. A consultation is the only way to get an accurate quote for your specific goals.</p>
    </section>
    {%- else %}
    <section class="guide-section">
      <h2>{{ treatment.name }} prices in {{ neighborhood.name }}</h2>
      {%- if reference and reference.available %}
      <p>No provider in {{ neighborhood.name }} publishes a rate for {{ treatment.name | lower }} online — common in aesthetics, where cost depends on your individual plan. For a market reference,
        <a href="{{ reference.national.source_url }}" target="_blank" rel="noopener nofollow">{{ reference.national.source_name }}</a>
        reports <strong>{{ reference.national.display }}</strong> {{ reference.national.basis }} nationally{% if reference.national.year %} ({{ reference.national.year }}){% endif %}{% if reference.metro %}, and an average of <strong>{{ reference.metro.display }}</strong> {{ reference.metro.basis }}{% endif %}.
        {% if reference.excludes_anesthesia_facility %}That figure is the surgeon's fee only — anesthesia and accredited-facility costs are billed separately.{% endif %}
        Treat it as a reference point, not a quote: each clinic sets its own rate.</p>
      {%- else %}
      <p>No provider in {{ neighborhood.name }} publishes a rate for {{ treatment.name | lower }} online, and no independent body publishes an average cost for it — so there is no range we can honestly show you here. Request current pricing below and we'll get real numbers from the {{ n_clinics }} verified providers listed.</p>
      {%- endif %}
    </section>
    {%- endif %}

    {%- if guidance %}
    <section class="guide-section">
      <h2>What to know about {{ treatment.name | lower }}</h2>
      <p>{{ guidance }}</p>
    </section>
    {%- endif %}

    <section class="guide-section">
      <h2>{{ n_clinics }} verified {{ treatment.name | lower }} providers in {{ neighborhood.name }}</h2>
      <p>Every provider below has a verified address, phone number, and real Google rating. Prices are shown where published.</p>
      <a href="{{ listing_url }}" class="btn primary guide-cta">Compare all {{ n_clinics }} {{ neighborhood.name }} providers →</a>
    </section>

    {%- if faqs %}
    <section class="guide-section guide-faq">
      <h2>Frequently asked questions</h2>
      <div class="faq-list">
        {%- for f in faqs %}
        <details class="faq-item">
          <summary class="faq-q">{{ f.q }}</summary>
          <div class="faq-a"><p>{{ f.a }}</p></div>
        </details>
        {%- endfor %}
      </div>
    </section>
    {%- endif %}

    <section class="guide-section" style="background:var(--blue-tint);border:1px solid var(--blue-line);border-radius:10px;padding:24px">
      <div class="label blue" style="margin-bottom:8px">Ready to compare?</div>
      <p style="font-size:16px;font-weight:600;margin-bottom:12px">See all verified {{ treatment.name | lower }} providers in {{ neighborhood.name }}, FL</p>
      <a href="{{ listing_url }}" class="btn primary">View {{ n_clinics }} providers →</a>
    </section>
  </article>
</main>

<footer class="foot">
  <div class="wrap">
    Octoru is an independent med spa &amp; aesthetics directory. Prices are sourced from provider websites and may change; always confirm directly with your provider.
    <a href="{{ listing_url }}">Back to {{ neighborhood.name }} {{ treatment.name | lower }} listings</a> ·
    <a href="/advertise.html">Advertise your clinic</a> ·
    <a href="/privacy">Privacy</a>
    <div class="label" style="margin-top:10px">Updated {{ last_updated }}</div>
  </div>
</footer>

</body>
</html>
