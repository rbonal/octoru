</script>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-382MGP656E"></script><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-382MGP656E');</script>
</head><body>
<header class="topbar"><div class="wrap"><a href="/" style="text-decoration:none"><span class="brand-lockup"><svg class="brand-mark" width="28" height="28" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg"><polygon points="62,47 47,62 25,62 10,47 10,25 25,10 47,10 62,25" fill="#1447E6"/><path d="M27,33 H33 V27 H39 V33 H45 V39 H39 V45 H33 V39 H27 Z" fill="#fff"/></svg><span class="wordmark" style="font-size:21px">octoru</span></span><div class="label">Directorio de med spas y estética</div></a><span class="label blue">Sur de Florida</span></div></header>
<main class="wrap">
<nav class="breadcrumb" aria-label="Ruta"><a href="/">Inicio</a><span class="sep">/</span><a href="/fl/">Florida</a><span class="sep">/</span><a href="/fl/{{ metro.slug }}/">{{ metro.name }}</a><span class="sep">/</span><span aria-current="page">{{ treatment_name }}</span></nav>
<article class="guide-article">
<header class="guide-hero"><div class="label blue" style="margin-bottom:10px">&iacute;ndice de precios {{ year }}</div><h1>{{ treatment_name }} en la zona de {{ metro.name }}</h1>
<p class="guide-lead">Encuentra proveedores de {{ treatment_name|lower }} por zona y consulta qué clínicas publican ofertas.</p></header>
<section class="guide-section"><h2>{{ treatment_name }} por zona en {{ metro.name }}</h2>
<div class="table-wrap"><table class="price-table"><thead><tr><th scope="col">Zona</th><th scope="col">Proveedores locales</th><th scope="col">Precios</th></tr></thead><tbody>
{%- for r in rows %}
<tr><td class="area"><a href="{{ r.url }}">{{ r.city_name }}</a></td><td class="prov">{{ "Opciones cercanas" if r.fallback else r.n_clinics }}</td><td>{% if r.fallback %}Ver clínicas cercanas{% elif r.n_priced %}{{ r.n_priced }} con ofertas publicadas{% else %}Solicitar presupuesto{% endif %}</td></tr>
{%- endfor %}
</tbody></table></div></section>
</article>
</main>
<footer class="foot"><div class="wrap">Octoru es un directorio independiente de med spas y estética. Los precios provienen de listados de proveedores y pueden cambiar; confirma siempre directamente con tu proveedor. <a href="/advertise.html">Anuncia tu cl&iacute;nica</a> &middot; <a href="/claim.html">Reclama un listado</a> &middot; <a href="/privacy">Privacidad</a> &middot; <a href="/about">Acerca de</a><div class="label" style="margin-top:10px">Actualizado {{ last_updated }}</div></div></footer>
</body></html>
