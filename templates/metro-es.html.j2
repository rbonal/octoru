<link rel="stylesheet" href="/assets/styles.css">
<style>.table-wrap{overflow-x:auto;margin:6px 0 2px;border:1px solid var(--line);border-radius:var(--r)}.price-table{width:100%;border-collapse:collapse;font-size:15px;min-width:420px}.price-table th,.price-table td{padding:12px 18px;text-align:left;border-bottom:1px solid var(--line)}.price-table thead th{font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--mute);background:var(--pale);font-weight:600}.price-table thead th:last-child{text-align:center}.price-table tbody tr:last-child td{border-bottom:0}.price-table tbody tr:hover{background:var(--blue-tint)}.price-table td.area{font-weight:600;color:var(--ink)}.price-table td.price{white-space:nowrap;font-variant-numeric:tabular-nums;color:var(--ink-2)}.price-table td.price.na{color:var(--mute)}.price-table td.prov{text-align:center;color:var(--ink-3)}.price-table td.area a{color:var(--blue);text-decoration:none}.price-table td.area a:hover{text-decoration:underline}</style>
