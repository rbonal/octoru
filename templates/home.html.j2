<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GlowMap — Find &amp; compare med spas across South Florida</title>
<meta name="description" content="Compare verified med spa providers for Botox, lip filler, CoolSculpting, laser hair removal and microneedling — by city, with prices and ratings.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/styles.css">
</head>
<body class="home">

<header class="bar">
  <div class="wrap">
    <a href="/"><span class="brand">GlowMap<span class="sub label">Med spa directory</span></span></a>
    <nav class="bar-nav">
      <a href="#treatments">Treatments</a>
      <a href="#areas">Areas</a>
      <a href="#how">How it works</a>
      <a href="/fl/" class="region label blue">South Florida</a>
    </nav>
  </div>
</header>

<!-- ===================== HERO ===================== -->
<section class="hero">
  <div class="wrap">
    <div class="eyebrow label blue reveal d1">South Florida</div>
    <h1 class="head reveal d1">Find &amp; <span class="accent">compare</span> med spas by treatment and city</h1>
    <p class="lead reveal d2">Verified providers for Botox, lip filler, CoolSculpting, laser hair removal and microneedling — by city, with prices and ratings, so you can compare before you book.</p>

    <div class="geo-suggest reveal d3" id="geoSuggest">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
      <span>Looks like you're near <strong id="geoCity">your area</strong>.</span>
      <a class="go" id="geoGo" href="#">See med spas there →</a>
      <button class="x" id="geoDismiss" aria-label="Dismiss suggestion">✕</button>
    </div>

    <div class="search reveal d3">
      <input id="q" type="text" placeholder="Search a city or county — e.g. &ldquo;Coral Gables&rdquo; or &ldquo;Broward&rdquo;" aria-label="Search city or county">
      <button type="button">Search</button>
    </div>
    <div class="geo-row reveal d3">
      <button class="geo-btn" id="useLoc" type="button">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Use my location
      </button>
      <span class="geo-note">Used only to find the nearest area — never stored.</span>
    </div>
    <div class="geo-msg" id="geoMsg" aria-live="polite"></div>

    <div class="pills reveal d3" id="pills">
      <span class="pill active" data-treat="">All</span>
      {%- for t in treatments %}
      <span class="pill" data-treat="{{ t.slug }}">{{ t.name }}</span>
      {%- endfor %}
    </div>

    <div class="stats reveal d4">
      <span class="stat"><span class="n">{{ stats.listings }}</span><span class="t">provider listings</span></span>
      <span class="stat"><span class="n">{{ stats.cities }}</span><span class="t">cities</span></span>
      <span class="stat"><span class="n">{{ stats.counties }}</span><span class="t">counties</span></span>
      <span class="stat verified">✓ verified contact details</span>
    </div>
  </div>
</section>

<!-- ===================== TREATMENTS ===================== -->
<section class="block" id="treatments">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="label blue" style="margin-bottom:10px">Browse by treatment</div>
        <h2>Compare by what you're getting done</h2>
        <p>Pick a treatment to see providers, prices and ratings across South Florida.</p>
      </div>
    </div>
    <div class="treat-grid">
      {%- for t in treatments %}
      <a class="tcard" href="#areas">
        <div class="tname">{{ t.name }}</div>
        <div class="tdesc">{{ t.desc }}</div>
        <div class="tmeta">
          <span class="from">{% if t.from_display %}<span class="k">Typical from</span>{{ t.from_display }}{% else %}<span class="k">Pricing</span>Varies{% endif %}</span>
          <span class="arrow">→</span>
        </div>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- ===================== AREAS ===================== -->
<section class="block" id="areas" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="label blue" style="margin-bottom:10px">Browse by area</div>
        <h2>Choose your city</h2>
        <p>Every city links to treatment guides with local providers, prices and verified ratings.</p>
      </div>
    </div>

    {%- for g in groups %}
    <div class="county"{% if loop.first %} id="cities"{% endif %}>
      <div class="county-head"><h3>{{ g.name }}</h3><span class="label">{{ g.n_cities }} cit{{ "y" if g.n_cities == 1 else "ies" }}</span></div>
      <div class="city-grid">
        {%- for c in g.cities %}
        <a class="ccard" href="{{ c.url }}" data-search="{{ c.name | lower }}" data-treats="{{ c.data_treatments }}">
          <span><span class="cname">{{ c.name }}</span><span class="cmeta label">{{ c.n_treatments }} treatment{{ "s" if c.n_treatments != 1 }}</span></span>
          <span class="arrow">→</span>
        </a>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
  </div>
</section>

<!-- ===================== TRUST ===================== -->
<section class="trust" id="how">
  <div class="wrap">
    <div class="tr">
      <div class="num">01</div>
      <h4>Verified, not scraped</h4>
      <p>Contact details and ratings are pulled from permitted sources and date-stamped, so what you see is current — not copied review text.</p>
    </div>
    <div class="tr">
      <div class="num">02</div>
      <h4>Compare before you book</h4>
      <p>Prices, ratings and treatments side by side for each city, so you can shortlist in minutes instead of opening ten tabs.</p>
    </div>
    <div class="tr">
      <div class="num">03</div>
      <h4>Independent</h4>
      <p>GlowMap isn't owned by any clinic. Featured placements are clearly labeled; everything else is ranked on the merits.</p>
    </div>
  </div>
</section>

<!-- ===================== FOOTER ===================== -->
<footer class="foot">
  <div class="wrap">
    <div class="row">
      <div class="disc">
        <span class="brand" style="font-size:16px">GlowMap</span><br>
        GlowMap is an independent directory. Listings reflect publicly available information; ratings are sourced via permitted APIs.
        <div class="label" style="margin-top:12px">Updated {{ last_updated }}</div>
      </div>
      <div class="links">
        <a href="/claim.html">Claim a listing</a>
        <a href="/privacy">Privacy</a>
        <a href="/about">About</a>
      </div>
    </div>
  </div>
</footer>

<script>
  // Treatment pills + search both filter the city cards (pills bind to filter on build).
  var pills = document.getElementById('pills');
  var q = document.getElementById('q');
  var activeTreat = '';
  function applyFilter(){
    var term = (q.value || '').trim().toLowerCase();
    document.querySelectorAll('.ccard').forEach(function(c){
      var name = c.getAttribute('data-search') || '';
      var treats = (c.getAttribute('data-treats') || '').split(' ');
      var okName = !term || name.indexOf(term) !== -1;
      var okTreat = !activeTreat || treats.indexOf(activeTreat) !== -1;
      c.style.display = (okName && okTreat) ? '' : 'none';
    });
  }
  pills.addEventListener('click', function(e){
    if(!e.target.classList.contains('pill')) return;
    pills.querySelectorAll('.pill').forEach(function(p){ p.classList.remove('active'); });
    e.target.classList.add('active');
    activeTreat = e.target.getAttribute('data-treat') || '';
    applyFilter();
  });
  q.addEventListener('input', applyFilter);

  // ============ GEOLOCATION ============
  // Covered cities with real centroids + real city-page URLs, generated from the directory data.
  var CITIES = {{ geo_cities_json | safe }};
  var MAX_MILES = 60;   // beyond this, don't force a city

  function milesBetween(a, b, c, d){
    var R = 3959, t = Math.PI/180;
    var dLat = (c-a)*t, dLng = (d-b)*t;
    var x = Math.sin(dLat/2)**2 + Math.cos(a*t)*Math.cos(c*t)*Math.sin(dLng/2)**2;
    return R * 2 * Math.atan2(Math.sqrt(x), Math.sqrt(1-x));
  }
  function nearestCity(lat, lng){
    var best = null, bd = Infinity;
    for(var i=0;i<CITIES.length;i++){ var dM = milesBetween(lat, lng, CITIES[i].lat, CITIES[i].lng); if(dM < bd){ bd = dM; best = CITIES[i]; } }
    return {city: best, miles: bd};
  }

  // "Use my location" — fires the permission prompt ONLY on this explicit click,
  // never on page load. Coordinates are used transiently to pick a city, then dropped.
  var geoMsg = document.getElementById('geoMsg');
  document.getElementById('useLoc').addEventListener('click', function(){
    if(!navigator.geolocation){ geoMsg.textContent = 'Location isn’t available here — search by city above.'; return; }
    geoMsg.textContent = 'Finding the nearest area…';
    navigator.geolocation.getCurrentPosition(
      function(pos){
        var r = nearestCity(pos.coords.latitude, pos.coords.longitude);   // computed locally — no API, nothing sent
        if(r.city && r.miles <= MAX_MILES){ window.location.href = r.city.url; }
        else { geoMsg.textContent = 'We don’t cover your area yet — browse South Florida below.'; }
      },
      function(){ geoMsg.textContent = 'No problem — search by city above instead.'; },
      {enableHighAccuracy:false, timeout:8000, maximumAge:600000}
    );
  });

  // Optional IP-based suggestion (NO permission prompt). In production, read the visitor's
  // city from the CDN/edge geo header (Cloudflare cf-ipcity, Vercel x-vercel-ip-city),
  // match it to a covered city in CITIES (by name), then call showSuggest(name, url).
  // Dormant here: a static file has no server header. PLUG-IN POINT ↓
  function showSuggest(cityName, url){
    document.getElementById('geoCity').textContent = cityName;
    document.getElementById('geoGo').href = url;
    document.getElementById('geoSuggest').classList.add('show');
  }
  document.getElementById('geoDismiss').addEventListener('click', function(){
    document.getElementById('geoSuggest').classList.remove('show');
  });
</script>
</body>
</html>
