<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GlowMap — Find &amp; compare med spas across South Florida</title>
<meta name="description" content="Compare verified med spa providers for Botox, lip filler, CoolSculpting, laser hair removal and microneedling — by city, with prices and ratings.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/styles.css">
</head>
<body class="home">

<header class="bar">
  <div class="wrap">
    <a href="/"><span class="brand">GlowMap<span class="sub label">Med spa directory</span></span></a>
    <nav class="bar-nav">
      <a href="#treatments">Treatments</a>
      <a href="#areas">Areas</a>
      <a href="#how">How it works</a>
      <a href="/advertise.html" class="nav-adv-btn">Advertise with us</a>
      <a href="/fl/" class="region label blue">South Florida</a>
    </nav>
  </div>
</header>

<!-- ===================== HERO ===================== -->
<section class="hero">
  <div class="wrap">
   <div class="hero-grid">
    <div class="hero-main">
      <div class="eyebrow label blue reveal d1">South Florida</div>
      <h1 class="head reveal d1">Find &amp; <span class="accent">compare</span> med spas by treatment and city</h1>
      {%- if avg_rating %}
      <p class="lead reveal d2">Verified providers for Botox, lip filler, CoolSculpting, laser hair removal and microneedling — average {{ avg_rating }}-star Google rating, real prices, so you can compare before you book.</p>
      {%- else %}
      <p class="lead reveal d2">Verified providers for Botox, lip filler, CoolSculpting, laser hair removal and microneedling — by city, with prices and ratings, so you can compare before you book.</p>
      {%- endif %}

      <div class="geo-suggest reveal d3" id="geoSuggest">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>Looks like you're near <strong id="geoCity">your area</strong>.</span>
        <a class="go" id="geoGo" href="#">See med spas there →</a>
        <button class="x" id="geoDismiss" aria-label="Dismiss suggestion">&#x2715;</button>
      </div>

      <div class="search reveal d3">
        <input id="q" type="text" placeholder="Search a city — e.g. Brickell, Coral Gables, Fort Lauderdale" aria-label="Search city or county">
        <button type="button">Find providers</button>
      </div>
      <div class="geo-row reveal d3">
        <button class="geo-btn" id="useLoc" type="button">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Use my location
        </button>
        <span class="geo-note">Used only to find the nearest area — never stored.</span>
      </div>
      <div class="geo-msg" id="geoMsg" aria-live="polite"></div>

      {%- if top_searches %}
      <div class="top-searches reveal d3">
        <span class="label">Top searches</span>
        {%- for s in top_searches %}
        <a href="{{ s.url }}" class="ts-pill">{{ s.label }}</a>
        {%- endfor %}
      </div>
      {%- endif %}

      <div class="pills reveal d3" id="pills">
        <span class="pill active" data-treat="">All</span>
        {%- for t in treatments %}
        <span class="pill" data-treat="{{ t.slug }}">{{ t.name }}</span>
        {%- endfor %}
      </div>
    </div><!-- /hero-main -->

    <aside class="hero-side reveal d4">
      <div class="side-stats">
        <div class="ss"><span class="n">{{ stats.listings }}</span><span class="t">provider listings</span></div>
        <div class="ss"><span class="n">{{ stats.cities }}</span><span class="t">cities covered</span></div>
        {%- if avg_rating %}
        <div class="ss"><span class="n">{{ avg_rating }}</span><span class="t">avg. Google rating</span></div>
        {%- else %}
        <div class="ss"><span class="n">{{ stats.counties }}</span><span class="t">counties</span></div>
        {%- endif %}
        <div class="ss verified">&#x2713; verified contact details</div>
      </div>
      <div class="side-jump">
        <div class="label" style="margin-bottom:8px">Jump to a county</div>
        {%- for g in groups %}
        <a href="#{{ g.slug }}">{{ g.short_name }} <span class="ar">&#x2192;</span></a>
        {%- endfor %}
      </div>
      <div class="side-clinic-cta">
        <span>Own a clinic?</span>
        <a href="/advertise.html">Get featured &#x2192;</a>
      </div>
    </aside>
   </div><!-- /hero-grid -->
  </div>
</section>

<!-- ===================== TREATMENTS ===================== -->
<section class="block" id="treatments">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="label blue" style="margin-bottom:10px">Browse by treatment</div>
        <h2>Compare by what you're getting done</h2>
        <p>Pick a treatment to see providers, verified ratings and real prices across South Florida.</p>
      </div>
    </div>
    <div class="treat-grid">
      {%- for t in treatments %}
      <a class="tcard" href="{{ t.url }}">
        <div class="tname">{{ t.name }}</div>
        <div class="tdesc">{{ t.desc }}</div>
        <div class="tmeta">
          <span class="from">{% if t.from_display %}<span class="k">Typical from</span>{{ t.from_display }}{% else %}<span class="k">Pricing</span>Varies{% endif %}</span>
          <span class="arrow">&#x2192;</span>
        </div>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- ===================== AREAS ===================== -->
<section class="block" id="areas" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <div class="label blue" style="margin-bottom:10px">Browse by area</div>
        <h2>Choose your city</h2>
        <p>Every city links to treatment guides with local providers, real prices and verified Google ratings.</p>
      </div>
    </div>

    {%- for g in groups %}
    <div class="county" id="{{ g.slug }}">
      <div class="county-head"><h3>{{ g.name }}</h3><span class="label">{{ g.n_cities }} cit{{ "y" if g.n_cities == 1 else "ies" }}</span></div>
      <div class="city-grid">
        {%- for c in g.cities %}
        <a class="ccard" href="{{ c.url }}" data-search="{{ c.name | lower }}" data-treats="{{ c.data_treatments }}">
          <span><span class="cname">{{ c.name }}</span><span class="cmeta label">{{ c.n_treatments }} treatment{{ "s" if c.n_treatments != 1 }}</span></span>
          <span class="arrow">&#x2192;</span>
        </a>
        {%- endfor %}
      </div>
    </div>
    {%- endfor %}
  </div>
</section>

<!-- ===================== TRUST ===================== -->
<section class="trust" id="how">
  <div class="wrap">
    <div class="tr">
      <div class="num">01</div>
      <h4>Verified, not scraped</h4>
      <p>Ratings come from Google Places. Contact details are pulled from each clinic's own site and date-stamped — no copied review text, no made-up numbers.</p>
    </div>
    <div class="tr">
      <div class="num">02</div>
      <h4>Compare before you book</h4>
      <p>Prices, ratings and treatments side by side for every city — shortlist in minutes instead of opening ten tabs.</p>
    </div>
    <div class="tr">
      <div class="num">03</div>
      <h4>Independent</h4>
      <p>GlowMap is not owned by any clinic. Featured placements are clearly labeled; everything else is ranked on rating and coverage.</p>
    </div>
  </div>
</section>

<!-- ===================== FOOTER ===================== -->
<footer class="foot">
  <div class="wrap">
    <div class="row">
      <div class="disc">
        <span class="brand" style="font-size:16px">GlowMap</span><br>
        GlowMap is an independent directory. Listings reflect publicly available information; ratings are sourced via Google Places API.
        <div class="label" style="margin-top:12px">Updated {{ last_updated }}</div>
      </div>
      <div class="links">
        <a href="/advertise.html">Advertise your clinic</a>
        <a href="/claim.html">Claim a listing</a>
        <a href="/privacy">Privacy</a>
        <a href="/about">About</a>
      </div>
    </div>
  </div>
</footer>

<script>
  var pills = document.getElementById('pills');
  var q = document.getElementById('q');
  var activeTreat = '';

  // ── SEARCH NAVIGATION ──────────────────────────────────────────────────────
  // All city cards carry data-search (city name, lowercase) + data-treats + href.
  // On search: (1) try to find an exact/prefix city match and navigate there,
  // (2) if no match, scroll to #areas and filter the city grid so the user can see
  //     what's available. Enter key and the "Find providers" button both trigger this.
  function doSearch() {
    var raw = (q.value || '').trim();
    if (!raw) { document.getElementById('areas').scrollIntoView({behavior:'smooth'}); return; }
    var term = raw.toLowerCase();

    // Try to find a matching city card (exact name or prefix match)
    var cards = Array.prototype.slice.call(document.querySelectorAll('.ccard'));
    var match = null;
    // 1) exact
    for (var i = 0; i < cards.length; i++) {
      if ((cards[i].getAttribute('data-search') || '') === term) { match = cards[i]; break; }
    }
    // 2) starts-with
    if (!match) {
      for (var i = 0; i < cards.length; i++) {
        if ((cards[i].getAttribute('data-search') || '').indexOf(term) === 0) { match = cards[i]; break; }
      }
    }
    // 3) contains
    if (!match) {
      for (var i = 0; i < cards.length; i++) {
        if ((cards[i].getAttribute('data-search') || '').indexOf(term) !== -1) { match = cards[i]; break; }
      }
    }

    if (match) {
      // If a treatment pill is active, go straight to that treatment page in the matched city
      if (activeTreat) {
        var treats = (match.getAttribute('data-treats') || '').split(' ');
        if (treats.indexOf(activeTreat) !== -1) {
          var base = match.getAttribute('href') || '';
          if (base) { window.location.href = base + activeTreat + '/'; return; }
        }
      }
      // Otherwise navigate to the city hub page
      var href = match.getAttribute('href');
      if (href) { window.location.href = href; return; }
    }

    // No matching city — filter the grid and scroll down so the user sees results
    applyFilter();
    document.getElementById('areas').scrollIntoView({behavior:'smooth'});
  }

  // Wire: button click + Enter key
  document.querySelector('.search button').addEventListener('click', doSearch);
  q.addEventListener('keydown', function(e){ if (e.key === 'Enter') doSearch(); });

  // Live filter (cosmetic, while typing)
  function applyFilter(){
    var term = (q.value || '').trim().toLowerCase();
    document.querySelectorAll('.ccard').forEach(function(c){
      var name = c.getAttribute('data-search') || '';
      var treats = (c.getAttribute('data-treats') || '').split(' ');
      var okName = !term || name.indexOf(term) !== -1;
      var okTreat = !activeTreat || treats.indexOf(activeTreat) !== -1;
      c.style.display = (okName && okTreat) ? '' : 'none';
    });
  }
  pills.addEventListener('click', function(e){
    if(!e.target.classList.contains('pill')) return;
    pills.querySelectorAll('.pill').forEach(function(p){ p.classList.remove('active'); });
    e.target.classList.add('active');
    activeTreat = e.target.getAttribute('data-treat') || '';
    applyFilter();
  });
  q.addEventListener('input', applyFilter);

  var CITIES = {{ geo_cities_json | safe }};
  var MAX_MILES = 60;
  function milesBetween(a,b,c,d){var R=3959,t=Math.PI/180,dLat=(c-a)*t,dLng=(d-b)*t,x=Math.sin(dLat/2)**2+Math.cos(a*t)*Math.cos(c*t)*Math.sin(dLng/2)**2;return R*2*Math.atan2(Math.sqrt(x),Math.sqrt(1-x));}
  function nearestCity(lat,lng){var best=null,bd=Infinity;for(var i=0;i<CITIES.length;i++){var dM=milesBetween(lat,lng,CITIES[i].lat,CITIES[i].lng);if(dM<bd){bd=dM;best=CITIES[i];}}return{city:best,miles:bd};}
  var geoMsg=document.getElementById('geoMsg');
  document.getElementById('useLoc').addEventListener('click',function(){
    if(!navigator.geolocation){geoMsg.textContent='Location not available - search by city above.';return;}
    geoMsg.textContent='Finding the nearest area...';
    navigator.geolocation.getCurrentPosition(
      function(pos){var r=nearestCity(pos.coords.latitude,pos.coords.longitude);if(r.city&&r.miles<=MAX_MILES){window.location.href=r.city.url;}else{geoMsg.textContent='We do not cover your area yet - browse South Florida below.';}},
      function(){geoMsg.textContent='No problem - search by city above instead.';},
      {enableHighAccuracy:false,timeout:8000,maximumAge:600000}
    );
  });
  function showSuggest(cityName,url){document.getElementById('geoCity').textContent=cityName;document.getElementById('geoGo').href=url;document.getElementById('geoSuggest').classList.add('show');}
  document.getElementById('geoDismiss').addEventListener('click',function(){document.getElementById('geoSuggest').classList.remove('show');});
</script>

</body>
</html>
