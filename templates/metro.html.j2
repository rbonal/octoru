<!doctype html>
  <html lang="en"><head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ treatment_name }} Cost in {{ metro.name }} ({{ year }}) - Price Comparison | Octoru</title>
  <meta name="description" content="Compare {{ treatment_name }} prices across {{ n_areas }} {{ metro.name }}-area locations{% if low %}, from ${{ low }} {{ unit }}{% endif %}. Starting prices from {{ providers }} providers, side by side.">
  <link rel="canonical" href="{{ site_url }}/fl/{{ metro.slug }}/{{ treatment_slug }}/guide/"><link rel="alternate" hreflang="en" href="{{ site_url }}/fl/{{ metro.slug }}/{{ treatment_slug }}/guide/">{% if has_es %}<link rel="alternate" hreflang="es" href="{{ site_url }}/es/fl/{{ metro.slug }}/{{ treatment_slug }}/guide/"><link rel="alternate" hreflang="x-default" href="{{ site_url }}/fl/{{ metro.slug }}/{{ treatment_slug }}/guide/">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet"><link rel="stylesheet" href="/assets/styles.css"><style>.table-wrap{overflow-x:auto;margin:6px 0 2px;border:1px solid var(--line);border-radius:var(--r)}.price-table{width:100%;border-collapse:collapse;font-size:15px;min-width:420px}.price-table th,.price-table td{padding:12px 18px;text-align:left;border-bottom:1px solid var(--line)}.price-table thead th{font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--mute);background:var(--pale);font-weight:600}.price-table thead th:last-child{text-align:center}.price-table tbody tr:last-child td{border-bottom:0}.price-table tbody tr:hover{background:var(--blue-tint)}.price-table td.area{font-weight:600;color:var(--ink)}.price-table td.price{white-space:nowrap;font-variant-numeric:tabular-nums;color:var(--ink-2)}.price-table td.price.na{color:var(--mute);font-weight:400}.price-table td.prov{text-align:center;color:var(--ink-3)}.area-links{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px 18px}.area-links a{color:var(--blue);text-decoration:none}.area-links a:hover{text-decoration:underline}.price-table td.area a{color:var(--blue);text-decoration:none}.price-table td.area a:hover{text-decoration:underline}</style>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site_url }}/"},{"@type":"ListItem","position":2,"name":"Florida","item":"{{ site_url }}/fl/"},{"@type":"ListItem","position":3,"name":"{{ metro.name }}","item":"{{ site_url }}/fl/{{ metro.slug }}/"},{"@type":"ListItem","position":4,"name":"{{ treatment_name }} cost"}]}
</script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-382MGP656E"></script><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-382MGP656E');</script></head><body>
  <header class="topbar"><div class="wrap"><a href="/" style="text-decoration:none"><span class="brand-lockup"><svg class="brand-mark" width="28" height="28" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg"><polygon points="62,47 47,62 25,62 10,47 10,25 25,10 47,10 62,25" fill="#1447E6"/><path d="M27,33 H33 V27 H39 V33 H45 V39 H39 V45 H33 V39 H27 Z" fill="#fff"/></svg><span class="wordmark" style="font-size:21px">octoru</span></span><div class="label">Health &amp; wellness directory</div></a><span class="label blue">South Florida</span></div></header>
  <main class="wrap">
  <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="sep">/</span><a href="/fl/">Florida</a><span class="sep">/</span><a href="/fl/{{ metro.slug }}/">{{ metro.name }}</a><span class="sep">/</span><span aria-current="page">{{ treatment_name }} cost</span></nav>
  <article class="guide-article">
  <header class="guide-hero"><div class="label blue" style="margin-bottom:10px">{{ year }} price index</div><h1>How much does {{ treatment_name }} cost in {{ metro.name }}?</h1>
  {% if low %}<div class="guide-price-callout"><span class="guide-price-n">${{ low }}{% if high and high != low %} to ${{ high }}{% endif %} {{ unit }}</span><span class="guide-price-note">starting prices across {{ n_areas }} {{ metro.name }}-area locations</span></div>{% endif %}
  <p class="guide-lead">Aesthetic-treatment pricing varies widely across {{ metro.name }}. This index compares starting {{ treatment_name }} prices from providers in {{ n_areas }} {{ metro.name }} neighborhoods and cities, so you can see the real local range before booking a consultation.{% if priced_count %} {{ priced_count }} of {{ n_areas }} areas have published pricing;{% endif %} final cost depends on the provider and your treatment plan.</p></header>
<section class="guide-section"><h2>{{ treatment_name }} prices by {{ metro.name }} area</h2>
  <div class="table-wrap"><table class="price-table"><thead><tr><th>Area</th><th>Starting price</th><th>Providers</th></tr></thead><tbody>
  {% for r in rows %}<tr><td class="area"><a href="{{ r.url }}">{{ r.city_name }}</a></td><td class="price{% if not r.from_price %} na{% endif %}">{% if r.from_price %}${{ r.from_price }} {{ unit }}{% elif ref_price %}~${{ ref_price }} {{ unit }} (area ref){% else %}Request a quote{% endif %}</td><td class="prov">{{ r.n_clinics }}</td></tr>{% endfor %}
  </tbody></table></div>
  <p style="margin-top:12px">Prices shown are starting rates sourced from provider listings; final cost depends on the treatment area, the units or sessions required, and the specific provider. Always confirm at a consultation.</p></section>
  <section class="guide-section" style="background:var(--blue-tint);border:1px solid var(--blue-line);border-radius:10px;padding:24px"><div class="label blue" style="margin-bottom:8px">Compare providers by area</div><ul class="area-links">{% for r in rows %}<li><a href="{{ r.url }}">{{ r.city_name }} {{ treatment_name }} providers</a></li>{% endfor %}</ul></section>
  </article>
  </main>
  <footer class="foot"><div class="wrap">Octoru is an independent health &amp; wellness price directory. Prices are sourced from provider listings and may change; always confirm directly with your provider. <a href="/advertise.html">Advertise your clinic</a> &middot; <a href="/claim.html">Claim a listing</a> &middot; <a href="/privacy">Privacy</a> &middot; <a href="/about">About</a><div class="label" style="margin-top:10px">Updated {{ last_updated }}</div></div></footer>
  </body></html>
