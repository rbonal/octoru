<!doctype html>
<html lang="en"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ metro.name }} Aesthetic Treatment Prices ({{ year }}) | Octoru</title>
<meta name="description" content="Compare starting prices for aesthetic treatments across {{ metro.name }}, FL by neighborhood - botox, fillers and more.">
<link rel="canonical" href="{{ site_url }}/fl/{{ metro.slug }}/">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet"><link rel="stylesheet" href="/assets/styles.css">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<style>.metro-guides{list-style:none;padding:0;margin:8px 0;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}.metro-guides a{display:block;border:1px solid var(--line);border-radius:var(--r);padding:16px 18px;text-decoration:none;color:var(--ink)}.metro-guides a:hover{border-color:var(--blue);background:var(--blue-tint)}.metro-guides .mg-t{display:block;font-weight:600;font-size:16px}.metro-guides .mg-m{display:block;color:var(--mute);font-size:14px;margin-top:4px}</style>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"{{ site_url }}/"},{"@type":"ListItem","position":2,"name":"Florida","item":"{{ site_url }}/fl/"},{"@type":"ListItem","position":3,"name":"{{ metro.name }}"}]}
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-382MGP656E"></script><script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-382MGP656E');</script></head><body>
<header class="topbar"><div class="wrap"><a href="/" style="text-decoration:none"><span class="brand-lockup"><svg class="brand-mark" width="28" height="28" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg"><polygon points="62,47 47,62 25,62 10,47 10,25 25,10 47,10 62,25" fill="#1447E6"/><path d="M27,33 H33 V27 H39 V33 H45 V39 H39 V45 H33 V39 H27 Z" fill="#fff"/></svg><span class="wordmark" style="font-size:21px">octoru</span></span><div class="label">Med spa &amp; aesthetics directory</div></a><span class="label blue">South Florida</span></div></header>
<main class="wrap">
<nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span class="sep">/</span><a href="/fl/">Florida</a><span class="sep">/</span><span aria-current="page">{{ metro.name }}</span></nav>
<article class="guide-article">
<header class="guide-hero"><div class="label blue" style="margin-bottom:10px">{{ year }} price index</div><h1>{{ metro.name }} aesthetic treatment prices</h1>
<p class="guide-lead">Compare starting prices for aesthetic treatments across {{ metro.name }} neighborhoods and cities. Select a treatment to see the full price comparison by area.</p></header>
<section class="guide-section"><ul class="metro-guides">
{% for it in items %}<li><a href="/fl/{{ metro.slug }}/{{ it.treatment_slug }}/guide/"><span class="mg-t">{{ it.treatment_name }} prices</span><span class="mg-m">{% if it.low %}from ${{ it.low }}{% if it.unit %} {{ it.unit }}{% endif %} &middot; {% endif %}{{ it.n_areas }} areas &middot; {{ it.providers }} providers</span></a></li>{% endfor %}
</ul></section>
</article>
</main>
<footer class="foot"><div class="wrap">Octoru is an independent med spa &amp; aesthetics price directory. Prices are sourced from provider listings and may change; always confirm directly with your provider. <a href="/advertise.html">Advertise your clinic</a> &middot; <a href="/claim.html">Claim a listing</a> &middot; <a href="/privacy">Privacy</a> &middot; <a href="/about">About</a><div class="label" style="margin-top:10px">Updated {{ last_updated }}</div></div></footer>
</body></html>
