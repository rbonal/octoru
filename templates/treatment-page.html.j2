<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ meta_description }}">
{%- if fallback %}
<!-- Nearest-provider fallback page (no local providers): noindex but follow, so it serves
     users who land here and passes link equity to the real provider pages, without
     competing in search as a near-duplicate. -->
<meta name="robots" content="noindex, follow">
{%- elif near_duplicate %}
<!-- Near-duplicate guard: this page's content is {{ (near_duplicate_overlap * 100) | round | int }}% shared with the closest
     same-treatment page, i.e. it is mostly boilerplate with too little local substance to
     stand on its own. It still serves visitors and passes link equity, but it is kept out
     of the index and the sitemap until it has more real local data. -->
<meta name="robots" content="noindex, follow">
{%- endif %}
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/x-icon" sizes="any" href="/assets/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
<meta property="og:image" content="https://octoru.com/assets/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://octoru.com/assets/og-image.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Octoru">
<meta property="og:title" content="{{ treatment.name }} in {{ neighborhood.name }}, {{ city }}: {{ clinics|length }} Top-Rated Clinic{{ 's' if clinics|length != 1 else '' }} & Prices ({{ updated[:4] }})">
<meta property="og:description" content="{{ meta_description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/styles.css">

{%- if faqs %}
<!-- FAQPage schema — targets People Also Ask boxes in Google -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for f in faqs %}
    {
      "@type": "Question",
      "name": {{ f.q | tojson }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ f.a | tojson }} }
    }{{ "," if not loop.last }}
    {%- endfor %}
  ]
}
</script>
{%- endif %}

<!-- schema.org: ItemList of MedicalClinic w/ AggregateRating (required by quality gate) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "{{ treatment.name }} in {{ neighborhood.name }}, {{ city }}",
  "itemListElement": [
    {%- for c in clinics %}
    {
      "@type": "ListItem",
      "position": {{ loop.index }},
      "item": {
        "@type": "MedicalClinic",
        "name": {{ c.name | tojson }},
        "address": {{ c.address | tojson }},
        "telephone": {{ c.phone | tojson }},
        {%- if c.surgeons %}
        "employee": [
          {%- for s in c.surgeons %}
          { "@type": "Physician", "name": {{ s.name | tojson }} }{{ "," if not loop.last }}
          {%- endfor %}
        ],
        {%- endif %}
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "{{ c.rating }}",
          "reviewCount": "{{ c.review_count }}"
        }
      }
    }{{ "," if not loop.last }}
    {%- endfor %}
  ]
}
</script>

{%- if breadcrumb %}
<!-- BreadcrumbList: hierarchy signal for search + 'near me' / city queries -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {%- for b in breadcrumb %}
    { "@type": "ListItem", "position": {{ loop.index }}, "name": {{ b.name | tojson }}, "item": "{{ site_url }}{{ b.url }}" }{{ "," if not loop.last }}
    {%- endfor %}
  ]
}
</script>
{%- endif %}
<!-- Google Analytics 4 (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-382MGP656E"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-382MGP656E');
</script>
</head>
<body>

<header class="topbar">
  <div class="wrap">
    <a href="/" style="text-decoration:none">
      <span class="brand-lockup"><svg class="brand-mark" width="28" height="28" viewBox="0 0 72 72" xmlns="http://www.w3.org/2000/svg"><polygon points="62,47 47,62 25,62 10,47 10,25 25,10 47,10 62,25" fill="#1447E6"/><path d="M27,33 H33 V27 H39 V33 H45 V39 H39 V45 H33 V39 H27 Z" fill="#fff"/></svg><span class="wordmark" style="font-size:21px">octoru</span></span>
      <div class="label">Med spa &amp; aesthetics directory</div>
    </a>
    <span class="label blue">{{ neighborhood.name }}</span>
  </div>
</header>

<main class="wrap">
  {%- if breadcrumb %}
  <nav class="breadcrumb" aria-label="Breadcrumb">
    {%- for b in breadcrumb %}
    {%- if not loop.last %}<a href="{{ b.url }}">{{ b.name }}</a><span class="sep">/</span>
    {%- else %}<span aria-current="page">{{ b.name }}</span>{% endif %}
    {%- endfor %}
  </nav>
  {%- endif %}

  <section class="hero">
    <span class="label blue">{{ treatment.name }}</span>
    <h1>{{ treatment.name }} in {{ neighborhood.name }}, {{ city }}</h1>
    <p class="lead">{{ intro }}</p>
    <div class="updated label">Updated {{ updated or last_updated }} · ratings via Google</div>
  </section>

  {%- if cost %}
  {#- Three-tier pricing. (a) referential market range, always labeled and sourced;
      (b) what providers on this page actually publish; (c) an honest ask for the rest.
      No tier ever borrows a number from another. -#}
  <section class="costblock">
    {%- if cost.reference and cost.reference.available %}
    <span class="label">Typical {{ treatment.name | lower }} cost — market reference</span>
    <div class="cost-figure">{{ cost.reference.national.display }}<span class="cost-unit">{{ cost.reference.national.basis }}</span></div>
    <div class="cost-ref-meta">
      <span class="ref-tag">Referential range</span>
      Published U.S. figure from
      <a href="{{ cost.reference.national.source_url }}" target="_blank" rel="noopener nofollow">{{ cost.reference.national.source_name }}</a>{% if cost.reference.national.year %}, {{ cost.reference.national.year }}{% endif %}.
      {%- if cost.reference.national_alt %}
      {{ cost.reference.national_alt.source_name }} reports {{ cost.reference.national_alt.display }} {{ cost.reference.national_alt.basis }}.
      {%- endif %}
      {%- if cost.reference.metro %}
      For the Miami metro specifically, {{ cost.reference.metro.source_name }} reports an average of
      <strong>{{ cost.reference.metro.display }}</strong> ({{ cost.reference.metro.basis }}{% if cost.reference.metro.year %}, {{ cost.reference.metro.year }}{% endif %}).
      {%- elif cost.reference.metro_absent_reason %}
      No Miami-specific published average exists for this treatment, so the national figure is shown instead.
      {%- endif %}
      {%- if cost.reference.excludes_anesthesia_facility %}
      This is a <strong>surgeon's fee only</strong> — anesthesia and facility costs are billed separately and are not included.
      {%- endif %}
      <strong>This is a market reference, not a quote — each clinic sets its own rate.</strong>
    </div>
    {%- else %}
    <span class="label">{{ treatment.name }} pricing in {{ neighborhood.name }}</span>
    <div class="cost-ref-meta">No independent body publishes an average cost for {{ treatment.name | lower }},
      so we don't show a range we can't source. Prices are set per provider —
      <a href="#quote">request current pricing</a> and we'll get it for you.</div>
    {%- endif %}

    {%- if cost.has_prices %}
    <div class="cost-observed">
      <span class="label">Published by providers on this page</span>
      <span class="cost-observed-figure">{% if cost.low == cost.high %}${{ "{:,}".format(cost.low) }}{% else %}${{ "{:,}".format(cost.low) }}–${{ "{:,}".format(cost.high) }}{% endif %}</span>
      <span class="cost-observed-note">{{ cost.coverage_label }}. Each figure below links to where that provider published it. Starting prices — your final cost depends on your treatment plan.</span>
    </div>
    {%- else %}
    <div class="cost-observed">
      <span class="cost-observed-note">{{ cost.coverage_label }}.</span>
    </div>
    {%- endif %}
  </section>
  {%- endif %}

  {%- if fallback %}
  <div class="nearby-note">
    <strong>No {{ treatment.name | lower }} providers in {{ neighborhood.name }} yet.</strong>
    These are the nearest board-certified options, ordered by distance. The rating shown on each
    is for the practice, not an individual surgeon.
  </div>
  {%- endif %}

  <!-- featured clinics first; featured_tier drives ordering + the blue edge -->
  <section class="clinics">
    {%- for c in clinics %}
    <article class="clinic{{ ' featured' if c.featured_tier and c.featured_tier > 0 }}">
      <div>
        {% if c.featured_tier and c.featured_tier > 0 %}<span class="featured-tag">Featured</span>{% elif c.top_ranked %}<span class="top-tag">★ Top rated</span>{% endif %}
        {% if c.nearby_city_name %}<span class="nearby-tag">Nearby · ~{{ c.nearby_distance_mi }} mi · {{ c.nearby_city_name }}</span>{% endif %}
        <div class="name">{{ c.name }}</div>
        <div class="meta">{{ c.neighborhood }}{% if c.languages %} · {{ c.languages | join(", ") }}{% endif %}</div>
        {% if c.address %}<div class="meta">{{ c.address }}</div>{% else %}<div class="meta muted">Address not listed</div>{% endif %}
        <div class="stats">
          {% if c.rating %}<span class="stat"><span class="label">Rating</span><span class="v">{{ c.rating }} ({{ c.review_count }})</span></span>{% endif %}
          {%- if c.starting_price_usd %}
          {#- Tier (b): shown ONLY with the basis the provider published it on, and linked
              to where we read it. A bare number without its basis would mislead. -#}
          <span class="stat"><span class="label">From</span><span class="v">${{ "{:,}".format(c.starting_price_usd) }}{% if c.price_basis %} <span class="price-basis">{{ c.price_basis }}</span>{% elif c.price_unit %} {{ c.price_unit }}{% endif %}</span>{% if c.price_source_url %} <a class="price-src" href="{{ c.price_source_url }}" target="_blank" rel="noopener nofollow" title="Published by this provider{% if c.price_checked %}, checked {{ c.price_checked }}{% endif %}">source ↗</a>{% endif %}</span>
          {%- else %}
          <span class="stat empty"><a href="#quote">Request current price</a></span>
          {%- endif %}
          {% if c.phone_display %}<span class="stat"><span class="label">Phone</span><span class="v">{{ c.phone_display }}</span></span>{% endif %}
        </div>
        {% if c.treatments_offered %}<div class="tags">{% for tt in c.treatments_offered %}<span class="tag">{{ tt }}</span>{% endfor %}</div>{% endif %}
        {%- if c.accreditations %}
        <div class="accred" title="As listed on the provider's website: {{ c.accreditation_stated }}">
          <span class="accred-k">✓ Accredited facility</span>
          {%- for a in c.accreditations %}<span class="accred-badge">{{ a }}</span>{% endfor %}
          {%- if c.accreditation_source %}<a class="accred-src" href="{{ c.accreditation_source }}" target="_blank" rel="noopener nofollow">source ↗</a>{% endif %}
        </div>
        {%- endif %}
        {%- if c.surgeons %}
        <div class="surgeons">
          <span class="label">Surgeon{{ "s" if c.surgeons | length > 1 }} performing {{ treatment.name | lower }} here</span>
          {%- for s in c.surgeons %}
          <div class="surgeon">
            <span class="surgeon-name">{{ s.name }}</span>
            {%- if s.credentials_text %}<span class="surgeon-cred">{{ s.credentials_text }}</span>{% endif %}
            {%- if s.credentials_source %}<a class="surgeon-src" href="{{ s.credentials_source }}" target="_blank" rel="noopener nofollow">Credentials as listed on the provider's website ↗</a>{% endif %}
          </div>
          {%- endfor %}
          <p class="surgeon-disclaimer">The rating above is for this practice, not an individual surgeon. Confirm each surgeon's credentials and facility accreditation at your consultation.</p>
        </div>
        {%- endif %}
        <div class="claim-line">
          <a href="/claim.html?clinic={{ c.slug | urlencode }}&amp;name={{ c.name | urlencode }}">Own this clinic? Claim or correct this listing</a>
          {%- if not (c.featured_tier and c.featured_tier > 0) %}
          · <a href="/advertise.html?clinic={{ c.slug | urlencode }}&amp;city={{ neighborhood.slug | urlencode }}" class="featured-cta">Get featured →</a>
          {%- endif %}
        </div>
      </div>
      <div class="actions">
        {# Contact is FREE — routes direct to clinic. Never metered or billed per inquiry.
           Paid placements carry rel="sponsored" on outbound links (FTC / Google requirement). #}
        {% if c.booking_url -%}
        <a class="btn primary" href="{{ c.booking_url }}" target="_blank" {% if c.sponsored %}rel="sponsored noopener"{% else %}rel="noopener"{% endif %}>Book online</a>
        {%- elif c.phone -%}
        <a class="btn primary" href="tel:{{ c.phone }}">Call to book</a>
        {%- else -%}
        <a class="btn primary" href="#quote">Request info (free)</a>
        {%- endif %}
        {% if c.phone %}<a class="btn" href="tel:{{ c.phone }}">Call</a>{% endif %}
        {% if c.email %}<a class="btn" href="mailto:{{ c.email }}" {% if c.sponsored %}rel="sponsored"{% endif %}>Email</a>{% endif %}
        {% if c.google_listing_url %}<a class="btn" href="{{ c.google_listing_url }}" target="_blank" rel="noopener nofollow">View on Google</a>{% endif %}
      </div>
    </article>
    {%- endfor %}
  </section>

  {%- if guidance %}
  <section class="guidance">
    <h2>About {{ treatment.name | lower }}</h2>
    <p>{{ guidance }}</p>
    <p class="disclaimer">General guidance only — not medical advice. Confirm specifics with a licensed provider during your consultation.</p>
  </section>
  {%- endif %}

  {%- if faqs %}
  <!-- FAQ section — FAQPage schema above targets People Also Ask rich results -->
  <section class="faq-section" id="faq">
    <h2>Frequently asked questions about {{ treatment.name | lower }} in {{ neighborhood.name }}</h2>
    <div class="faq-list">
      {%- for f in faqs %}
      <details class="faq-item">
        <summary class="faq-q">{{ f.q }}</summary>
        <div class="faq-a"><p>{{ f.a }}</p></div>
      </details>
      {%- endfor %}
    </div>
    {%- if not fallback %}
    <p class="faq-guide-link">
      Looking for a full pricing breakdown?
      <a href="{{ breadcrumb[-1].url if breadcrumb else '' }}guide/">Read the {{ neighborhood.name }} {{ treatment.name | lower }} cost guide →</a>
    </p>
    {%- endif %}
  </section>
  {%- endif %}

  <!-- internal cross-links to related canonical pages (best-practice: keep every
       page within ~2 clicks, route link equity between related intent pages) -->
  {%- if same_treatment or other_treatments %}
  <section class="crosslinks">
    {%- if same_treatment %}
    <div class="xl-group">
      <span class="label">{{ treatment.name }} in nearby cities</span>
      <ul>
        {%- for p in same_treatment %}
        <li><a href="{{ p.url }}">{{ treatment.name }} in {{ p.name }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}
    {%- if other_treatments %}
    <div class="xl-group">
      <span class="label">Other treatments in {{ neighborhood.name }}</span>
      <ul>
        {%- for p in other_treatments %}
        <li><a href="{{ p.url }}">{{ p.name }} in {{ neighborhood.name }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}
  </section>
  {%- endif %}

  <!-- Free inquiry form — routes to a provider in this area at no charge.
       Octoru does not charge, meter, or sell per-patient/per-inquiry value.
       This form is a free convenience; the consent line is REQUIRED by the quality gate. -->
  <section class="lead-form" id="quote">
    <h2>Get in touch with a provider</h2>
    <p class="sub">This is a free inquiry — we'll forward your message to a matching {{ neighborhood.name }} provider at no charge to you or them.</p>
    <div class="field">
      <label for="lf-name">Name</label>
      <input id="lf-name" type="text" autocomplete="name">
    </div>
    <div class="field">
      <label for="lf-phone">Phone</label>
      <input id="lf-phone" type="tel" autocomplete="tel">
    </div>
    <div class="field">
      <label for="lf-email">Email</label>
      <input id="lf-email" type="email" autocomplete="email">
    </div>
    <div class="field">
      <label for="lf-treatment">Treatment</label>
      <select id="lf-treatment"><option>{{ treatment.name }}</option></select>
    </div>
    <div class="consent">
      <input id="lf-consent" type="checkbox">
      <label for="lf-consent">I consent to being contacted about my inquiry and have read the
        <a href="/privacy">privacy policy</a>. My information is used only to connect me with a provider.</label>
    </div>
    <button class="btn primary submit">Send inquiry (free)</button>
  </section>
</main>

<footer class="foot">
  <div class="wrap">
    Octoru is an independent med spa &amp; aesthetics directory. Listings reflect publicly available information; ratings are sourced via permitted APIs.
    <a href="/learn/">Treatment guides</a> · <a href="/advertise.html">Advertise your clinic</a> · <a href="/claim.html">Claim listing</a> · <a href="/privacy">Privacy</a> · <a href="/about">About</a>
    <div class="label" style="margin-top:10px;">Last updated {{ last_updated }}</div>
  </div>
</footer>

</body>
</html>
